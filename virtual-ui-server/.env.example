# Server port (ignored on Vercel)
PORT=8000

# MongoDB connection string (Atlas or local)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/virtual-ui

# Any long random string — signs the auth JWT
JWT_SECRET=

# https://openrouter.ai/keys — used for AI component generation
OPENROUTER_API_KEY=

# https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173
